+// Original code: isolated UI cost diagnostic, never production.
+class UiDiagnostic {
+ static final clock=Stopwatch()..start();
+ static bool enabled=false;
+ static bool fixedBounds=false;
+ static final ticks=<String,int>{};
+ static final counts=<String,int>{};
+ static final reasons=<String,int>{};
+ static int get now=>clock.elapsedTicks;
+ static void add(String key,int start){if(enabled){ticks.update(key,(v)=>v+clock.elapsedTicks-start,ifAbsent:()=>clock.elapsedTicks-start);counts.update(key,(v)=>v+1,ifAbsent:()=>1);}}
+ static void reason(String key){if(enabled)reasons.update(key,(v)=>v+1,ifAbsent:()=>1);}
+ static void reset(){enabled=false;ticks.clear();counts.clear();reasons.clear();}
+ static Map<String,Object> result()=>{'frequency':clock.frequency,'ticks':Map.of(ticks),'counts':Map.of(counts),'fallback':Map.of(reasons)};
+}
