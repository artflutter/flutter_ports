+/// Prepares a typed color once, retaining its CSS channels for public reads.
+PreparedColor prepareColor(Color color) {
+  final value = rawColorOf(color)!;
+  final red = (value.red * 255).round().clamp(0, 255);
+  final green = (value.green * 255).round().clamp(0, 255);
+  final blue = (value.blue * 255).round().clamp(0, 255);
+  final alpha = value.alpha.clamp(0.0, 1.0);
+  // rgbParse keeps alpha * 255; Color.rgb applies b2n before the canvas
+  // rounds back to a byte. Preserve that order, including halfway cases.
+  final opacity = (alpha * 255 / 2.55 + 0.5).truncateToDouble() / 100;
+  final paint = Color.fromARGB(
+    (opacity * 255).round().clamp(0, 255),
+    red,
+    green,
+    blue,
+  );
+  return PreparedColor(red, green, blue, alpha, paint);
