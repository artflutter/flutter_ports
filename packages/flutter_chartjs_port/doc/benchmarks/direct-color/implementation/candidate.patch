+// Original code, not ported from Chart.js: prepared colors and a CSS face.
+
+/// Internal colors keep their paint value without a string round trip. The
+/// public option face exposes the original CSS value on demand.
+library;
+
+import 'dart:collection';
+
+import 'package:flutter_chartjs_port/src/js/js_number.dart'
+    show jsNumberToString;
+import 'package:meta/meta.dart' show internal;
+
+/// A typed color after the Flutter color-space conversion. [paint] belongs
+/// to the canvas layer; keeping it opaque preserves this layer's purity.
+@internal
+final class PreparedColor {
+  /// Keeps the CSS channels and the corresponding native paint color.
+  PreparedColor(this.red, this.green, this.blue, this.alpha, this.paint);
+
+  /// The clamped sRGB channel bytes.
+  final int red;
+
+  /// The green channel byte.
+  final int green;
+
+  /// The blue channel byte.
+  final int blue;
+
+  /// The original clamped alpha, before the canvas's percentage rounding.
+  final double alpha;
+
+  /// The native color, already normalized as the CSS parser would do.
+  final Object paint;
+
+  /// The observable value of the typed option before this adaptation.
+  late final String css =
+      'rgba($red, $green, $blue, ${jsNumberToString(alpha)})';
+}
+
+/// A color callback with separate internal and public results. Both paths
+/// call the user's callback exactly once; neither caches its answer.
+@internal
+final class PreparedColorCallback {
+  /// The callback used by the typed resolver.
+  PreparedColorCallback(this.resolve);
+
+  /// Computes one internal color for the supplied context and options.
+  final PreparedColor Function(Object?, Object?) resolve;
+
+  /// The ordinary Dart function exposed through the public option face.
+  // Identity is stable across repeated reads of the public option.
+  // ignore: prefer_function_declarations_over_variables
+  late final Object? Function(Object?, Object?) publicCall = (
+    context,
+    options,
+  ) => resolve(context, options).css;
+}
+
+/// A mutable color list whose ordinary reads remain CSS strings. The
+/// resolver reads [prepared] to avoid formatting each indexed color.
+@internal
+final class PreparedColorList extends ListBase<Object?> {
+  /// Takes ownership of a fresh, growable list of internal values.
+  PreparedColorList(this.prepared);
+
+  /// Internal values, including any later writes made through the List API.
+  final List<Object?> prepared;
+
+  @override
+  int get length => prepared.length;
+
+  @override
+  set length(int value) => prepared.length = value;
+
+  @override
+  Object? operator [](int index) => publicColorValue(prepared[index]);
+
+  @override
+  void operator []=(int index, Object? value) => prepared[index] = value;
+}
+
+/// Converts only internal color representations at an observable boundary.
+/// Raw user values and Lists keep their identity and behavior.
+@internal
+@pragma('vm:prefer-inline')
+@pragma('dart2js:prefer-inline')
+@pragma('wasm:prefer-inline')
+Object? publicColorValue(Object? value) => switch (value) {
+  PreparedColor(:final css) => css,
+  PreparedColorCallback(:final publicCall) => publicCall,
+  _ => value,
+};
+
+/// Canvas capability: only native canvases accept the internal paint value.
+/// Other Canvas 2D implementations continue to receive CSS strings.
+@internal
+abstract interface class PreparedColorContext {}
