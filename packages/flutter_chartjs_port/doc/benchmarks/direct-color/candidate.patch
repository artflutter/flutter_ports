+Color directPaintColor(Color color) {
+  final srgb = color.withValues(colorSpace: ColorSpace.extendedSRGB);
+  final alpha = srgb.a.clamp(0.0, 1.0);
+  // Preserve rgbParse -> Color.rgb (b2n) -> parseCssColor alpha rounding.
+  final opacity = ((alpha * 255 / 2.55 + 0.5).truncateToDouble() / 100);
+  return Color.fromARGB(
+    (opacity * 255).round().clamp(0, 255),
+    (srgb.r * 255).round().clamp(0, 255),
+    (srgb.g * 255).round().clamp(0, 255),
+    (srgb.b * 255).round().clamp(0, 255),
+  );
+}
+
+Object _experimentColor(Color color) => directColorExperiment
+    ? directPaintColor(color) : colorToRgba(color);
+
+Object? colorValue(Color? color) => color == null ? null : _experimentColor(color);
 
